# Headers para Netlify / Cloudflare Pages.
# Nenhum destes muda a nota do Lighthouse (o PageSpeed mede sempre cold load,
# e os audits de cache pesam 0). Eles existem para o usuário real e para
# limpar os avisos informativos de segurança do relatório.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# A fonte é o único subrecurso da página. Immutable elimina a revalidação
# em visitas recorrentes. Se trocar o arquivo, mude o nome do arquivo.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML sempre revalidado: o conteúdo muda, e o CSS vive dentro dele.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
